# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (segredos e chaves de segurança nunca devem ser versionados)
.env
.env.*
.env.example

# local editor and uploaded files
/.vscode/
/storage/

# database local
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-*
/database/*.db
/database/*.db-*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
