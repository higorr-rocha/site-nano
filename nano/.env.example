# Exemplo de configuração de variáveis de ambiente (.env)
NANO_DB_PATH=./database/nanoquimica.sqlite
NANO_SERVER_HMAC_SECRET=gere_uma_chave_hex_de_64_bytes_com_openssl_rand_hex_64
NANO_PBKDF2_ITERATIONS=100000
NANO_DUMMY_PASSWORD_SALT=gere_um_salt_hex_de_32_caracteres
NANO_DUMMY_PASSWORD_HASH=hash_pbkdf2_sha512_para_comparacao_em_tempo_constante
NANO_SESSION_COOKIE_NAME=nano_acesso_sid
NANO_SESSION_TTL_MS=28800000
NANO_CHALLENGE_TTL_MS=600000

# Cloudflare Turnstile (Modo Invisível)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=sua_site_key_cloudflare_turnstile
TURNSTILE_SECRET_KEY=sua_secret_key_cloudflare_turnstile
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
